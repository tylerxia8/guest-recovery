# Proposed configuration only; no runtime exists yet. Never put real secrets here.
APP_ENV=development
OPERATIONAL_TIMEZONE=America/New_York
RESERVATION_PROVIDER=mock
SMS_PROVIDER=mock
ROUTING_PROVIDER=mock
AUTH_PROVIDER=mock
PRODUCTION_INTEGRATIONS_ENABLED=false
PRODUCTION_DISPATCH_ENABLED=false
# Local-only non-secret infrastructure placeholders; configure actual URLs privately.
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Local and test mock HMAC secret. Leave empty here. Generate it in backend/.env via infra/local/bootstrap.sh.
AUTH_MOCK_SECRET=
CORS_ORIGINS=http://127.0.0.1:3000
# Account-specific Hospitable configuration must follow verified official docs.
HOSPITABLE_CREDENTIAL_SECRET_REF=
HOSPITABLE_WEBHOOK_SECRET_REF=
HOSPITABLE_READ_ONLY=false
HOSPITABLE_GUEST_DEPARTURE_ENABLED=false
LOCAL_FREE_ROUTING=false
HOSPITABLE_TOKEN_FILE=
FIELD_ENCRYPTION_KEY_FILE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
GOOGLE_MAPS_API_KEY=
# Proposed defaults requiring manager approval before dispatch activation.
AVAILABILITY_REQUEST_LOCAL_TIME=17:00
AVAILABILITY_CUTOFF_LOCAL_TIME=17:30
DISPATCH_LOCAL_TIME=18:00
ACK_REMINDER_MINUTES=30
ACK_ESCALATION_MINUTES=60
READINESS_BUFFER_MINUTES=30
AUTO_REASSIGN_MISSING_ACK=false
POLICY_APPROVAL_REQUIRED=true
# Proposed engineering defaults; validate during pilot.
SOLVER_TIME_LIMIT_SECONDS=30
RESERVATION_RECONCILE_MINUTES=15
ROUTING_CACHE_TTL_MINUTES=60
INTEGRATION_STALE_THRESHOLD_MINUTES=30

LOCAL_SCHEDULING_ENABLED=false
LOCAL_EMAIL_AUTOMATION_ENABLED=false
GMAIL_CREDENTIALS_FILE=
GMAIL_ASSIGNMENT_SEND_ENABLED=false
GMAIL_TEST_SEND_ENABLED=false

CLEANER_PORTAL_BASE_URL=http://localhost:3011
CLEANER_PORTAL_HOST=

WORKSPACE_INVITE_SIGNUP_ENABLED=false
